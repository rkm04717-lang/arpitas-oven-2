{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "arpitas-oven-2",
  "main": "./worker.js",
  "compatibility_date": "2026-09-29",

  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arpitas-oven-db",
      "database_id": "112e4613-0599-4e45-a9b1-8d8b74d46f07"
    }
  ]
}
